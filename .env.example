# Local Supabase values. Start the local stack with `npx supabase start` and
# copy the generated publishable key from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# No service-role/secret key is needed by normal app requests. Never add a
# Supabase secret key to a NEXT_PUBLIC_ variable or client-side code.

# Optional: your public address, used for invitation link previews (e.g. https://our-wedding.in).
NEXT_PUBLIC_SITE_URL=
